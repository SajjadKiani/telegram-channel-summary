TELEGRAM_BOT_TOKEN=replace_with_botfather_token
TELEGRAM_API_ID=replace_with_api_id_from_my_telegram_org
TELEGRAM_API_HASH=replace_with_api_hash_from_my_telegram_org
GEMINI_API_KEY=replace_with_gemini_api_key
GEMINI_MODEL=gemini-3.7-flash
MAX_LINKS=3
MAX_PAGE_CHARS=18000

# Deny-by-default access control. Add at least one allowed user or chat.
ALLOWED_USER_IDS=
ALLOWED_CHAT_IDS=
ALLOWED_CHANNEL_USERNAMES=

# Optional. Defaults to ~/.local/share/telegram-gemini-summary-bot/telegram_user_session
TELETHON_SESSION=
