TELEGRAM_BOT_TOKEN=replace_with_botfather_token
TELEGRAM_API_ID=replace_with_api_id_from_my_telegram_org
TELEGRAM_API_HASH=replace_with_api_hash_from_my_telegram_org
OPENROUTER_API_KEY=replace_with_openrouter_api_key
OPENROUTER_MODEL=openai/gpt-4o-mini
MAX_LINKS=3
MAX_PAGE_CHARS=18000

# Deny-by-default access control. Add at least one allowed user or chat.
ALLOWED_USER_IDS=
ALLOWED_CHAT_IDS=
ALLOWED_CHANNEL_USERNAMES=

# Optional. Defaults to ~/.local/share/telegram-gemini-summary-bot/telegram_user_session
TELETHON_SESSION=

# --- channel_digest.py (folder digest script) ---
# Exact name of the Telegram folder (chat folder) that contains the channels to digest.
DIGEST_FOLDER_NAME=replace_with_your_folder_name
# Where digests get sent: a channel/chat username (e.g. mydigestchannel) or numeric chat ID.
# Your Telethon user account must be a member/admin able to post there.
DIGEST_TARGET_CHAT=replace_with_target_channel_username_or_id
# How many hours back to pull posts from each channel (used as the fallback window
# on the first run per channel; later runs use saved per-channel state instead).
DIGEST_HOURS=24

# Docker only: seconds between digest_loop.sh runs. Defaults to DIGEST_HOURS * 3600.
DIGEST_LOOP_SECONDS=
